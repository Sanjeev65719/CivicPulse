        st.subheader("📈 Resolution Time Trend")
        if "resolution_time_hours" in working_df.columns:
            fig_trend = viz.create_resolution_time_trend(working_df)
            st.plotly_chart(fig_trend, use_container_width=True)
        else:
            st.info("Parse dates first to see resolution time trends.")

        st.divider()

        # SLA breach distribution
        st.subheader("⏰ SLA Breach Distribution")
        if "sla_breached" in working_df.columns:
            fig_sla = viz.create_sla_breach_distribution(working_df)
            st.plotly_chart(fig_sla, use_container_width=True)
        else:
            # Try to compute on the fly
            if "resolution_time_hours" in working_df.columns and "category" in working_df.columns:
                temp = working_df.copy()
                temp["sla_breached"] = temp.apply(
                    lambda r: (
                        1 if pd.notna(r.get("resolution_time_hours"))
                        and r["resolution_time_hours"] > get_sla_threshold(r.get("category", ""))
                        else 0
                    ) if r.get("status") == "Resolved" else None,
                    axis=1,
                )
                temp = temp.dropna(subset=["sla_breached"])
                temp["sla_breached"] = temp["sla_breached"].astype(int)
                fig_sla = viz.create_sla_breach_distribution(temp)
                st.plotly_chart(fig_sla, use_container_width=True)
            else:
                st.info("Parse dates and train the SLA model first to see breach distributions.")


