# ─────────────────────────────────────────────────────────────────────────────
# TAB 1 — DATA INGESTION
# ─────────────────────────────────────────────────────────────────────────────
with tab_ingestion:
    st.header("📥 Data Ingestion")
    st.markdown("Upload a CSV or XLSX file, load the built-in sample dataset, or pull data from an API endpoint.")

    ingestion = DataIngestion()

    src_choice = st.radio(
        "Select data source",
        ["📁 Upload File", "📊 Sample Dataset", "🌐 API Endpoint"],
        horizontal=True,
        key="ingestion_source",
    )

    if src_choice == "📁 Upload File":
        uploaded = st.file_uploader(
            "Choose a CSV or XLSX file",
            type=["csv", "xlsx", "xls"],
            key="file_upload",
        )
        if uploaded:
            if not validate_file_size(uploaded, max_size_mb=50):
                st.error(f"File exceeds 50 MB limit ({format_bytes(uploaded.size)}).")
            else:
                try:
                    df = ingestion.load_file(uploaded)
                    st.session_state.data = df
                    st.session_state.current_step = max(st.session_state.current_step, 1)
                    st.success(f"✅ Loaded **{len(df):,}** rows × **{len(df.columns)}** columns from `{uploaded.name}`.")
                except Exception as exc:
                    st.error(f"Failed to read file: {exc}")

    elif src_choice == "📊 Sample Dataset":
        if st.button("Load Sample Data", type="primary", key="load_sample"):
            with st.spinner("Loading sample civic complaints…"):
                try:
                    df = ingestion.load_sample_data()
                    st.session_state.data = df
                    st.session_state.current_step = max(st.session_state.current_step, 1)
                    st.success(f"✅ Loaded sample dataset — **{len(df):,}** rows × **{len(df.columns)}** columns.")
                except Exception as exc:
                    st.error(f"Failed to load sample data: {exc}")

    else:  # API
        api_url = st.text_input("API URL", placeholder="https://api.example.com/complaints")
        col_a, col_b = st.columns(2)
        api_key = col_a.text_input("API Key (optional)", type="password")
        headers_json = col_b.text_input("Extra Headers (JSON, optional)")
        if st.button("Fetch Data", type="primary", key="fetch_api"):
            if not api_url:
                st.warning("Please provide a URL.")
            else:
                with st.spinner("Fetching…"):
                    try:
                        df = ingestion.load_from_api(api_url, api_key or None, headers_json or None)
                        st.session_state.data = df
                        st.session_state.current_step = max(st.session_state.current_step, 1)
                        st.success(f"✅ Fetched **{len(df):,}** rows from API.")
                    except Exception as exc:
                        st.error(f"API error: {exc}")

    # Preview
    if st.session_state.data is not None:
        st.subheader("Data Preview")
        st.dataframe(st.session_state.data.head(20), use_container_width=True, height=400)


# ─────────────────────────────────────────────────────────────────────────────
# TAB 2 — DATA CLEANING
# ─────────────────────────────────────────────────────────────────────────────
with tab_cleaning:
    st.header("🧹 Data Cleaning")

    if st.session_state.data is None:
        st.info("⬅️ Load data in the **Data Ingestion** tab first.")
    else:
        cleaner = DataCleaning()
        df = st.session_state.data.copy()

        # Quality assessment
        st.subheader("Data Quality Report")
        quality = cleaner.assess_data_quality(df)

        col1, col2, col3, col4 = st.columns(4)
        col1.metric("Total Rows", f"{quality['total_rows']:,}")
        col2.metric("Total Columns", quality["total_columns"])
        col3.metric("Duplicates", quality["duplicate_count"])
        col4.metric("Invalid Coords", quality["invalid_coordinates_count"])

        # Missing values
        if quality["missing_percentage"]:
            with st.expander("📉 Missing Values (% per column)", expanded=False):
                missing_df = pd.DataFrame.from_dict(
                    quality["missing_percentage"], orient="index", columns=["Missing %"]
                ).sort_values("Missing %", ascending=False)
                st.dataframe(missing_df, use_container_width=True)

        # Data types
        with st.expander("🔤 Data Types", expanded=False):
            dtype_df = pd.DataFrame.from_dict(
                quality["dtype_summary"], orient="index", columns=["Type"]
            )
            st.dataframe(dtype_df, use_container_width=True)

        st.divider()

        # Cleaning actions
        st.subheader("Cleaning Actions")

        col_a, col_b = st.columns(2)

        with col_a:
            st.markdown("**Column Standardisation**")
            if st.button("Standardise Column Names", key="std_cols"):
                df = cleaner.standardize_column_names(df)
                st.session_state.data = df
                st.success("Column names standardised ✔️")

            st.markdown("**Remove Duplicates**")
            if st.button("Remove Duplicates", key="rm_dup"):
                before = len(df)
                df = cleaner.remove_duplicates(df)
                st.session_state.data = df
                st.success(f"Removed {before - len(df)} duplicate(s) ✔️")

        with col_b:
            st.markdown("**Handle Missing Values**")
            strategy = st.selectbox(
                "Strategy",
                ["drop", "fill_mean", "fill_mode"],
                key="missing_strategy",
            )
            if st.button("Apply Missing-Value Strategy", key="handle_missing"):
                before = len(df)
                df = cleaner.handle_missing_values(df, strategy=strategy)
                st.session_state.data = df
                st.success(f"Applied '{strategy}' — {before - len(df)} rows affected ✔️")

        st.divider()

        # Coordinate validation
        st.subheader("🗺️ Coordinate Validation")
        if st.button("Validate Coordinates (Bengaluru bbox)", key="validate_coords"):
            df = cleaner.validate_coordinates(df)
            st.session_state.data = df
            invalid = (~df["coordinates_valid"]).sum() if "coordinates_valid" in df.columns else 0
            st.success(f"Validation complete — **{invalid}** rows outside bounding box ✔️")

        # Date parsing
        st.subheader("📅 Date Parsing")
        if st.button("Parse Dates & Compute Resolution Time", key="parse_dates"):
            df = cleaner.parse_dates(df)
            st.session_state.data = df
            has_rt = "resolution_time_hours" in df.columns
            st.success(
                f"Dates parsed ✔️"
                + (f" — `resolution_time_hours` column created." if has_rt else "")
            )

        st.divider()

        # Finalize
        if st.button("✅ Finalize Cleaned Data", type="primary", key="finalize_clean"):
            st.session_state.cleaned_data = st.session_state.data.copy()
            st.session_state.current_step = max(st.session_state.current_step, 2)
            st.success("Cleaned data saved to session ✔️")
            st.dataframe(st.session_state.cleaned_data.head(10), use_container_width=True)


# ─────────────────────────────────────────────────────────────────────────────
# TAB 3 — STORAGE & QUERIES
# ─────────────────────────────────────────────────────────────────────────────
with tab_storage:
    st.header("🗄️ Storage & Queries")

    working_df = st.session_state.cleaned_data if st.session_state.cleaned_data is not None else st.session_state.data

    if working_df is None:
        st.info("⬅️ Load and clean data first.")
    else:
        # Init DB manager
        if st.session_state.db_manager is None:
            db_path = os.path.join(PROJECT_ROOT, "civicpulse.db")
            st.session_state.db_manager = DatabaseManager(db_path)

        db = st.session_state.db_manager

        # Save
        st.subheader("💾 Save to Database")
        table_name = st.text_input("Table name", value="complaints", key="table_name")
        if st.button("Save DataFrame to SQLite", type="primary", key="save_db"):
            with st.spinner("Saving…"):
                db.save_dataframe(working_df, table_name)
                st.session_state.current_step = max(st.session_state.current_step, 3)
            st.success(f"Saved **{len(working_df):,}** rows to `{table_name}` ✔️")

        # DB info
        with st.expander("ℹ️ Database Info"):
            info = db.get_database_info()
            if info["table_names"]:
                for t in info["table_names"]:
                    tbl_info = info.get(t, {})
                    st.markdown(f"**{t}** — {tbl_info.get('row_count', '?')} rows, columns: `{', '.join(tbl_info.get('column_names', []))}`")
            else:
                st.caption("No tables yet.")

        st.divider()

        # NLP Query
        st.subheader("💬 Natural-Language Query")
        if st.session_state.ai_services is None:
            st.session_state.ai_services = AIServices()

        ai = st.session_state.ai_services

        nl_question = st.text_input(
            "Ask a question about the data",
            placeholder="e.g. Which ward has the most complaints?",
            key="nl_query",
        )
        if st.button("Ask", key="ask_nl"):
            if nl_question:
                schema_info = db.get_database_info()
                sql = ai.natural_language_to_sql(nl_question, schema_info)
                st.code(sql, language="sql")
                result = db.execute_query(sql)
                if not result.empty:
                    st.dataframe(result, use_container_width=True)
                else:
                    st.warning("Query returned no results.")

        st.divider()

        # Raw SQL
        st.subheader("🔧 Raw SQL Query")
        raw_sql = st.text_area(
            "Enter SQL",
            placeholder="SELECT * FROM complaints LIMIT 10",
            key="raw_sql",
        )
        if st.button("Execute", key="exec_sql"):
            if raw_sql:
                result = db.execute_query(raw_sql)
                if not result.empty:
                    st.dataframe(result, use_container_width=True)
                else:
                    st.warning("Query returned no results or an error occurred.")


# ─────────────────────────────────────────────────────────────────────────────
# TAB 4 — HOTSPOT DETECTION
# ─────────────────────────────────────────────────────────────────────────────
with tab_hotspot:
    st.header("📍 Hotspot Detection")

    working_df = st.session_state.cleaned_data if st.session_state.cleaned_data is not None else st.session_state.data

    if working_df is None:
        st.info("⬅️ Load and clean data first.")
    else:
        st.markdown("Configure DBSCAN parameters to detect geographic complaint clusters.")

        col1, col2 = st.columns(2)
        eps_km = col1.slider("Radius (km)", 0.1, 5.0, 0.5, 0.1, key="eps_km")
        min_samples = col2.slider("Min samples per cluster", 2, 20, 5, 1, key="min_samples")

        if st.button("🔍 Run Hotspot Detection", type="primary", key="run_hotspot"):
            with st.spinner("Running DBSCAN clustering…"):
                # Load analytics dependencies only when this action is requested.
                from modules.hotspot_detection import HotspotDetector
                detector = HotspotDetector(eps_km=eps_km, min_samples=min_samples)
                df_with_clusters = detector.detect_hotspots(working_df)
                summary = detector.summarize_hotspots(df_with_clusters)
                ranked = detector.rank_hotspots_by_severity(summary)

                st.session_state.hotspot_detector = detector
                st.session_state.hotspot_results = {
                    "clustered_df": df_with_clusters,
                    "summary": summary,
                    "ranked": ranked,
                }
                st.session_state.current_step = max(st.session_state.current_step, 4)

            n_clusters = df_with_clusters["cluster_id"].nunique()
            noise = (df_with_clusters["cluster_id"] == -1).sum()
            real_clusters = n_clusters - (1 if -1 in df_with_clusters["cluster_id"].values else 0)

            st.success(f"Detected **{real_clusters}** hotspot cluster(s) — {noise} noise points.")

        # Display results
        if st.session_state.hotspot_results is not None:
            results = st.session_state.hotspot_results

            st.subheader("🗺️ Hotspot Map")
            from modules.visualization import Visualization
            viz = Visualization()
            fig = viz.create_hotspot_map(results["clustered_df"])
            st.plotly_chart(fig, use_container_width=True)

            st.subheader("📊 Hotspot Summary (Ranked by Severity)")
            if not results["ranked"].empty:
                st.dataframe(
                    results["ranked"].style.format({
                        "centroid_lat": "{:.4f}",
                        "centroid_lon": "{:.4f}",
                        "avg_resolution_time": "{:.1f}h",
                        "severity_score": "{:.3f}",
                    }),
                    use_container_width=True,
                )
            else:
                st.info("No clusters detected with the current parameters.")


# ─────────────────────────────────────────────────────────────────────────────
# TAB 5 — SLA PREDICTION
# ─────────────────────────────────────────────────────────────────────────────
with tab_sla:
    st.header("⚠️ SLA Breach Prediction")

    working_df = st.session_state.cleaned_data if st.session_state.cleaned_data is not None else st.session_state.data

    if working_df is None:
        st.info("⬅️ Load and clean data first.")
    else:
        st.markdown("Train a Random Forest model to predict which open complaints may breach their SLA deadlines.")

        # Show SLA thresholds reference
        with st.expander("📋 SLA Thresholds Reference"):
            sla_data = {cat: f"{hrs}h ({hrs // 24}d)" for cat, hrs in [
                ("pothole", 168), ("streetlight", 72), ("garbage", 24),
                ("water_leakage", 48), ("drainage", 96),
            ]}
            st.table(pd.DataFrame.from_dict(sla_data, orient="index", columns=["Threshold"]))

        if st.button("🚀 Train SLA Prediction Model", type="primary", key="train_sla"):
            with st.spinner("Training Random Forest classifier…"):
                # scikit-learn is imported on demand to keep initial page load lean.
                from modules.sla_prediction import SLAPredictor
                predictor = SLAPredictor()
                try:
                    metrics = predictor.train(working_df)
                    st.session_state.sla_predictor = predictor
                    st.session_state.current_step = max(st.session_state.current_step, 5)

                    st.success("Model trained successfully! ✔️")

                    # Metrics display
                    col1, col2, col3, col4 = st.columns(4)
                    col1.metric("Accuracy", f"{metrics['accuracy']:.2%}")
                    col2.metric("Precision", f"{metrics['precision']:.2%}")
                    col3.metric("Recall", f"{metrics['recall']:.2%}")
                    col4.metric("F1 Score", f"{metrics['f1']:.2%}")

                    st.caption(f"Train set: {metrics['train_size']} | Test set: {metrics['test_size']}")

                    # Feature importances
                    with st.expander("🔑 Top Feature Importances"):
                        imp_df = pd.DataFrame.from_dict(
                            metrics["feature_importances"], orient="index", columns=["Importance"]
                        ).sort_values("Importance", ascending=False)
                        st.bar_chart(imp_df, height=300)

                except Exception as exc:
                    st.error(f"Training failed: {exc}")

        st.divider()

        # Predict
        st.subheader("🔮 Predict Breach Risk for Open Complaints")
        if st.session_state.sla_predictor is not None and st.session_state.sla_predictor.is_trained:
            if st.button("Predict", type="primary", key="predict_sla"):
                predictor = st.session_state.sla_predictor
                try:
                    predictions = predictor.predict_breach_risk(working_df)
                    if predictions.empty:
                        st.info("No open complaints to predict.")
                    else:
                        # Add priority actions
                        predictions["priority_action"] = predictions.apply(
                            predictor.generate_priority_action, axis=1
                        )
                        st.session_state.prediction_results = predictions

                        # Summary
                        high = (predictions["breach_flag"] == "High Risk").sum()
                        med = (predictions["breach_flag"] == "Medium Risk").sum()
                        low = (predictions["breach_flag"] == "Low Risk").sum()

                        col1, col2, col3 = st.columns(3)
                        col1.metric("🔴 High Risk", high)
                        col2.metric("🟡 Medium Risk", med)
                        col3.metric("🟢 Low Risk", low)

                        st.dataframe(
                            predictions[[
                                "complaint_id", "category", "ward_name",
                                "breach_probability", "breach_flag", "priority_action"
                            ]].style.format({"breach_probability": "{:.2%}"}),
                            use_container_width=True,
                        )
                except Exception as exc:
                    st.error(f"Prediction error: {exc}")
        else:
            st.caption("Train the model first to make predictions.")


# ─────────────────────────────────────────────────────────────────────────────
# TAB 6 — VISUALIZATION
# ─────────────────────────────────────────────────────────────────────────────
with tab_viz:
