# ── Tab definitions ─────────────────────────────────────────────────────────
tab_ingestion, tab_cleaning, tab_storage, tab_hotspot, tab_sla, \
    tab_viz, tab_profiling, tab_settings = st.tabs([
        "📥 Data Ingestion",
        "🧹 Data Cleaning",
