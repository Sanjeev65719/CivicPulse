    if working_df is None:
        st.info("⬅️ Load and clean data first.")
    else:
        from modules.visualization import Visualization
        viz = Visualization()

        # Category breakdown
        st.subheader("🗂️ Category Breakdown")
        fig_cat = viz.create_category_breakdown_chart(working_df)
        st.plotly_chart(fig_cat, use_container_width=True)

        st.divider()

        # Ward comparison
        st.subheader("🏘️ Ward Comparison")
        if "resolution_time_hours" in working_df.columns:
            fig_ward = viz.create_ward_comparison_chart(working_df)
            st.plotly_chart(fig_ward, use_container_width=True)
        else:
            st.info("Parse dates first to compute resolution times for ward comparison.")

        st.divider()

