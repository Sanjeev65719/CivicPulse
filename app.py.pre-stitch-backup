# ── Cached Resource Singletons ───────────────────────────────────────────────
@st.cache_resource
def get_db_manager(db_path: str):
    """Cached database manager singleton."""
    return DatabaseManager(db_path)

@st.cache_resource
def get_ai_services():
    """Cached AI services singleton."""
    return AIServices()


# ── Session state initialisation ────────────────────────────────────────────
def init_session_state():
    """Initialise all session-state keys to safe defaults."""
    db_path = os.path.join(PROJECT_ROOT, "civicpulse.db")
    defaults = {
        "data": None,
        "cleaned_data": None,
        "db_manager": get_db_manager(db_path),
        "ai_services": get_ai_services(),
        "hotspot_detector": None,
        "sla_predictor": None,
        "hotspot_results": None,
        "prediction_results": None,
        "current_step": 0,
    }
    for key, val in defaults.items():
        if key not in st.session_state:
            st.session_state[key] = val

init_session_state()


# ── Sidebar ─────────────────────────────────────────────────────────────────
def render_sidebar():
    """Render the sidebar with workflow tracker and quick stats."""
    with st.sidebar:
        st.markdown("## 🏛️ CivicPulse")
        st.caption("Municipal Grievance Analytics")
        st.divider()

        # Workflow steps
        steps = [
            ("📥", "Data Ingestion"),
            ("🧹", "Data Cleaning"),
            ("🗄️", "Storage & Queries"),
            ("📍", "Hotspot Detection"),
            ("⚠️", "SLA Prediction"),
            ("📊", "Visualization"),
            ("📋", "Profiling Report"),
            ("⚙️", "Settings"),
        ]

        st.markdown("### Workflow Progress")
        for i, (icon, label) in enumerate(steps):
            if i < st.session_state.current_step:
                st.markdown(f"✅ ~~{icon} {label}~~")
            elif i == st.session_state.current_step:
                st.markdown(f"▶️ **{icon} {label}**")
            else:
                st.markdown(f"⬜ {icon} {label}")

        st.divider()

        # Quick stats
        if st.session_state.data is not None:
            df = st.session_state.data
            st.markdown("### 📈 Data Snapshot")
            col1, col2 = st.columns(2)
            col1.metric("Rows", f"{len(df):,}")
            col2.metric("Cols", len(df.columns))

            if "category" in df.columns:
                st.metric("Categories", df["category"].nunique())
            if "status" in df.columns:
                open_count = (df["status"] == "Open").sum()
                st.metric("Open Complaints", f"{open_count:,}")

render_sidebar()


